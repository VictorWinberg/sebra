VITE_DEBUG=true

# VITE_ENV=production
VITE_ENV=development

# VITE_BASE_URL=/base-url
VITE_BASE_URL=

# Frontend-only mode (sql.js in the browser). This is the default when VITE_API_URL is unset.
# Set VITE_LOCAL_MODE=false and VITE_API_URL to use the Payload backend instead.
# VITE_LOCAL_MODE=true

# VITE_API_URL=http://localhost:8080/api

SENTRY_AUTH_TOKEN=your-auth-token
